// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Student {
  id              String   @id @default(cuid())
  apaarId         String   @unique
  name            String
  dob             String
  gender          String
  mobile          String
  aadhaarLast4    String
  collegeId       String
  collegeName     String
  course          String
  year            Int
  abcCredits      Int
  tenthPercent    Float
  twelfthPercent  Float
  status          String   @default("pending") // "verified" | "pending" | "duplicate" | "rejected"
  category        String   @default("General") // "General" | "NRI" | "OCI" | "Foreign National" | "Supernumerary (TFW)"
  enrollmentNo    String   @default("")
  admissionDate   String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model College {
  id              String   @id
  name            String
  code            String   @unique
  state           String
  city            String
  approvedIntake  Int
  actualEnrolment Int
  verifiedCount   Int
  pendingCount    Int
  duplicateCount  Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model VerificationLog {
  id          String   @id @default(cuid())
  apaarId     String
  actorRole   String   // "STUDENT" | "COLLEGE_ADMIN" | "AICTE_ADMIN"
  actorEmail  String
  action      String   // "VERIFY" | "REJECT" | "CONSENT_GRANTED" | "BULK_UPLOAD" | "ANOMALY_FLAGGED"
  details     String
  ipAddress   String   @default("127.0.0.1")
  timestamp   DateTime @default(now())
}

model AnomalyRecord {
  id            String   @id @default(cuid())
  apaarId       String
  studentName   String
  anomalyType   String   // "DUPLICATE_CROSS_COLLEGE" | "INTAKE_EXCEEDED" | "INVALID_FORMAT" | "SUPERNUMERARY_EXCEEDED"
  colleges      String   // JSON string of involved colleges
  severity      String   // "CRITICAL" | "HIGH" | "MEDIUM"
  status        String   @default("OPEN") // "OPEN" | "RESOLVED" | "UNDER_REVIEW"
  detectedAt    DateTime @default(now())
}
