{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/frontend",
  "framework": "angular",
  "rewrites": [
    { "source": "/((?!assets|favicon\\.ico).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}

