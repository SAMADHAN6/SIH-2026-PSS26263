# ==============================================================================
# Git Ignore Configuration - AICTE APAAR Platform Monorepo
# ==============================================================================

# Node / NPM / Frontend Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# Frontend Build & Cache Outputs (Angular)
dist/
*/dist/
frontend/dist/
.angular/
*/.angular/
frontend/.angular/
tmp/
out-tsc/
bazel-out/

# Java / Maven / Backend Build Outputs
target/
*/target/
backend/target/
*.class
*.war
*.ear
*.nar
*.jar
# Allow Maven Wrapper JAR so ./mvnw works anywhere
!**/maven-wrapper.jar
!backend/.mvn/wrapper/maven-wrapper.jar

# Embedded / Local Database Files (H2 File-based & Postgres volumes)
backend/data/
data/
*.db
*.mv.db
*.trace.db

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cer
*.crt

# IDE & Editor Configurations
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
.factorypath
.springBeans
.sts4-cache
*.sublime-workspace
.history/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Test Coverage & Reports
coverage/
*/coverage/
test-results/
.nyc_output/
*.tsbuildinfo

# Cloud & Deployment Local Caches
.vercel/
.railway/
